# LUXA API environment. Validated at boot by src/config/env.schema.ts;
# the API exits with a list of problems if anything here is missing or unsafe.

# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Either DATABASE_URL, or DATABASE_HOST + DATABASE_USERNAME + DATABASE_NAME.
DATABASE_URL=postgresql://postgres:password@localhost:5432/luxa_sales
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=password
# DATABASE_NAME=luxa_sales
# require = TLS with certificate checks (production default)
# no-verify = TLS without checks (development only; refused in production)
# disable = no TLS (local Postgres)
DATABASE_SSL=disable
# DATABASE_CA=-----BEGIN CERTIFICATE-----...

# --- Auth ---
# Generate each with: openssl rand -base64 48   (must differ, 32+ chars)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRATION=7d

# Seals secrets at rest (2FA seeds). 32 bytes: openssl rand -base64 32
# Changing it makes existing 2FA enrolments unreadable.
ENCRYPTION_KEY=

# --- Web / CORS ---
FRONTEND_URL=http://localhost:3000
# Comma-separated exact origins. Defaults to the origin of FRONTEND_URL.
# CORS_ORIGINS=http://localhost:3000
# Parent domain for the session marker cookie the web app reads (luxa_csrf),
# e.g. luxa.app when the web is app.luxa.app and the API is api.luxa.app.
# Leave unset locally (localhost cookies are shared across ports).
# COOKIE_DOMAIN=luxa.app

# --- Logging ---
LOG_LEVEL=debug

# --- AI insights (optional) ---
AI_INSIGHTS_ENABLED=false
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_INSIGHTS_DIGEST_CRON=0 7 * * *

# --- Redis & background jobs (T39) ---
# Jobs (email, digests, maintenance), rate limits and caches. Railway: add the
# Redis plugin and reference its URL here, for both the API and the worker
# service (start command: pnpm --filter @luxa/backend run start:worker).
# Unset locally: jobs run inside the API and caches stay in memory.
# REDIS_URL=redis://localhost:6379

# --- Email (T39) ---
# Resend API key, and a sender on a domain verified in Resend. Without a key,
# development writes each email to MAIL_PREVIEW_DIR (open the .html files);
# production drops them with a warning.
# RESEND_API_KEY=
# EMAIL_FROM=LUXA <hello@luxa.app>
# MAIL_PREVIEW_DIR=.mail-preview
# Lagos-time cron for the nightly stock-ledger check.
# STOCK_INTEGRITY_CRON=30 2 * * *
