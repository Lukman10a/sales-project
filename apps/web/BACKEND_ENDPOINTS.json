{
  "project": "LUXA Sales Backend - NestJS Implementation",
  "version": "1.0",
  "date": "2026-02-09",
  "status": "Ready for Development",
  
  "modules": {
    "auth": {
      "description": "User authentication and token management",
      "endpoints": [
        {
          "id": "auth-1",
          "method": "POST",
          "path": "/auth/register",
          "description": "Create new business account",
          "access": "Public",
          "testOrder": 1,
          "request": {
            "email": "owner@business.com",
            "password": "SecurePass123!",
            "firstName": "John",
            "lastName": "Doe",
            "businessName": "Prime Store"
          },
          "expectedResponse": {
            "statusCode": 201,
            "hasToken": true,
            "hasRefreshToken": true
          }
        },
        {
          "id": "auth-2",
          "method": "POST",
          "path": "/auth/login",
          "description": "Authenticate user",
          "access": "Public",
          "testOrder": 2,
          "request": {
            "email": "owner@business.com",
            "password": "SecurePass123!"
          },
          "expectedResponse": {
            "statusCode": 200,
            "hasToken": true
          }
        },
        {
          "id": "auth-3",
          "method": "POST",
          "path": "/auth/refresh",
          "description": "Get new access token",
          "access": "Public",
          "testOrder": 3,
          "request": {
            "refreshToken": "refresh_token_value"
          },
          "expectedResponse": {
            "statusCode": 200,
            "hasToken": true
          }
        },
        {
          "id": "auth-4",
          "method": "POST",
          "path": "/auth/logout",
          "description": "Invalidate tokens",
          "access": "Authenticated",
          "testOrder": 100
        }
      ]
    },
    "profile": {
      "description": "User profile and settings management",
      "endpoints": [
        {
          "id": "prof-1",
          "method": "GET",
          "path": "/profile",
          "description": "Get current user profile",
          "access": "Authenticated",
          "testOrder": 4
        },
        {
          "id": "prof-2",
          "method": "PATCH",
          "path": "/profile",
          "description": "Update current user profile",
          "access": "Authenticated",
          "testOrder": 5,
          "request": {
            "firstName": "John",
            "phone": "+234-xxx-xxx",
            "address": "123 Main St"
          }
        },
        {
          "id": "prof-3",
          "method": "PATCH",
          "path": "/profile/preferences",
          "description": "Update notification preferences",
          "access": "Authenticated",
          "testOrder": 25
        },
        {
          "id": "prof-4",
          "method": "POST",
          "path": "/profile/change-password",
          "description": "Change user password",
          "access": "Authenticated",
          "testOrder": 26
        }
      ]
    },
    "inventory": {
      "description": "Product and inventory management",
      "endpoints": [
        {
          "id": "inv-1",
          "method": "GET",
          "path": "/inventory",
          "description": "List all products with pagination/filtering",
          "access": "Authenticated",
          "testOrder": 7,
          "queryParams": {
            "page": "number (default: 1)",
            "limit": "number (default: 20)",
            "category": "string (optional filter)",
            "status": "in-stock | low-stock | out-of-stock",
            "search": "string (search by name/sku)",
            "sort": "name | price-asc | price-desc | quantity | sold"
          }
        },
        {
          "id": "inv-2",
          "method": "GET",
          "path": "/inventory/:id",
          "description": "Get single product details",
          "access": "Authenticated",
          "testOrder": 8
        },
        {
          "id": "inv-3",
          "method": "POST",
          "path": "/inventory",
          "description": "Create new product",
          "access": "Authenticated (edit-products permission)",
          "testOrder": 6,
          "request": {
            "name": "iPhone 15",
            "category": ["Electronics", "Phones"],
            "sku": "IPH-15-128GB",
            "wholesalePrice": 400000,
            "sellingPrice": 550000,
            "quantity": 10,
            "reorderPoint": 5
          }
        },
        {
          "id": "inv-4",
          "method": "PATCH",
          "path": "/inventory/:id",
          "description": "Update product",
          "access": "Authenticated (edit-products permission)",
          "testOrder": 9,
          "request": {
            "quantity": 15,
            "sellingPrice": 575000
          }
        },
        {
          "id": "inv-5",
          "method": "DELETE",
          "path": "/inventory/:id",
          "description": "Delete product",
          "access": "Authenticated (delete-products permission)",
          "testOrder": 27,
          "expectedResponse": {
            "statusCode": 204
          }
        },
        {
          "id": "inv-6",
          "method": "POST",
          "path": "/inventory/:id/decrement",
          "description": "Reduce stock quantity (on sale)",
          "access": "Authenticated (record-sales permission)",
          "testOrder": 10,
          "request": {
            "quantity": 2
          }
        },
        {
          "id": "inv-7",
          "method": "POST",
          "path": "/inventory/bulk-import",
          "description": "Bulk import products via CSV/JSON",
          "access": "Authenticated (owner/manager)",
          "testOrder": 28,
          "request": {
            "format": "CSV or JSON file upload",
            "contentType": "multipart/form-data"
          }
        }
      ]
    },
    "sales": {
      "description": "Sales recording, history, and refunds",
      "endpoints": [
        {
          "id": "sal-1",
          "method": "GET",
          "path": "/sales",
          "description": "List all sales transactions",
          "access": "Authenticated (view-sales-history permission)",
          "testOrder": 12,
          "queryParams": {
            "page": "number",
            "limit": "number",
            "dateFrom": "ISO date",
            "dateTo": "ISO date",
            "status": "completed | pending | refunded | partial-refund",
            "paymentMethod": "cash | card | transfer | split | account",
            "sort": "date-desc | amount-desc | by-staff"
          }
        },
        {
          "id": "sal-2",
          "method": "GET",
          "path": "/sales/:id",
          "description": "Get single sale details",
          "access": "Authenticated",
          "testOrder": 13
        },
        {
          "id": "sal-3",
          "method": "POST",
          "path": "/sales",
          "description": "Record a new sale (complete transaction)",
          "access": "Authenticated (record-sales permission)",
          "testOrder": 11,
          "request": {
            "items": [
              {
                "productId": "uuid",
                "quantity": 1,
                "price": 550000
              }
            ],
            "discountPercent": 5,
            "paymentMethod": "cash",
            "customerId": "optional-uuid",
            "customerName": "Ahmed Hassan",
            "saleDate": "2026-02-09"
          }
        },
        {
          "id": "sal-4",
          "method": "PATCH",
          "path": "/sales/:id/refund",
          "description": "Process refund for a sale",
          "access": "Authenticated (owner/manager)",
          "testOrder": 14,
          "request": {
            "refundAmount": 522500,
            "refundReason": "Customer changed mind"
          }
        },
        {
          "id": "sal-5",
          "method": "POST",
          "path": "/sales/held",
          "description": "Hold a transaction (paused sale)",
          "access": "Authenticated (record-sales permission)",
          "testOrder": 15,
          "request": {
            "customerName": "Ahmed Hassan",
            "items": [],
            "discountPercent": 5,
            "paymentMethod": "cash"
          }
        },
        {
          "id": "sal-6",
          "method": "GET",
          "path": "/sales/held",
          "description": "List all held transactions",
          "access": "Authenticated",
          "testOrder": 16
        },
        {
          "id": "sal-7",
          "method": "DELETE",
          "path": "/sales/held/:id",
          "description": "Remove a held transaction",
          "access": "Authenticated",
          "testOrder": 17,
          "expectedResponse": {
            "statusCode": 204
          }
        }
      ]
    },
    "analytics": {
      "description": "Sales analytics and business insights",
      "endpoints": [
        {
          "id": "ana-1",
          "method": "GET",
          "path": "/dashboard",
          "description": "Get complete dashboard data",
          "access": "Authenticated (owner/manager)",
          "testOrder": 20,
          "queryParams": {
            "period": "today | week | month"
          }
        },
        {
          "id": "ana-2",
          "method": "GET",
          "path": "/analytics/summary",
          "description": "Get dashboard summary metrics",
          "access": "Authenticated (owner/manager)",
          "testOrder": 19,
          "queryParams": {
            "dateFrom": "ISO date (optional)",
            "dateTo": "ISO date (optional)",
            "period": "today | week | month"
          }
        },
        {
          "id": "ana-3",
          "method": "GET",
          "path": "/analytics/sales-chart",
          "description": "Get sales trend data for charts",
          "access": "Authenticated (owner/manager)",
          "testOrder": 21,
          "queryParams": {
            "period": "today-hourly | week-daily | month-weekly"
          }
        },
        {
          "id": "ana-4",
          "method": "GET",
          "path": "/analytics/category-breakdown",
          "description": "Get sales by category",
          "access": "Authenticated (owner/manager)",
          "testOrder": 22
        },
        {
          "id": "ana-5",
          "method": "GET",
          "path": "/analytics/top-products",
          "description": "Get top performing products",
          "access": "Authenticated (owner/manager)",
          "testOrder": 23,
          "queryParams": {
            "limit": "number (default: 5)",
            "period": "week | month | year"
          }
        }
      ]
    },
    "notifications": {
      "description": "Notification system and alerts",
      "endpoints": [
        {
          "id": "not-1",
          "method": "GET",
          "path": "/notifications",
          "description": "List user notifications",
          "access": "Authenticated",
          "testOrder": 18,
          "queryParams": {
            "read": "true | false | null (all)",
