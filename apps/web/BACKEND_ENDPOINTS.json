            "limit": "number (default: 20)"
          }
        },
        {
          "id": "not-2",
          "method": "PATCH",
          "path": "/notifications/:id/read",
          "description": "Mark notification as read",
          "access": "Authenticated",
          "testOrder": 24
        },
        {
          "id": "not-3",
          "method": "DELETE",
          "path": "/notifications/:id",
          "description": "Delete a notification",
          "access": "Authenticated",
          "testOrder": 29
        },
        {
          "id": "not-4",
          "method": "POST",
          "path": "/notifications/mark-all-read",
          "description": "Mark all notifications as read",
          "access": "Authenticated",
          "testOrder": 30
        }
      ]
    },
    "team": {
      "description": "Team management and permissions",
      "endpoints": [
        {
          "id": "tea-1",
          "method": "GET",
          "path": "/team",
          "description": "List all team members",
          "access": "Authenticated (assign-roles permission)",
          "testOrder": 31,
          "queryParams": {
            "status": "active | inactive | invited",
            "role": "owner | manager | sales-assistant | checkout | inventory"
          }
        },
        {
          "id": "tea-2",
          "method": "GET",
          "path": "/team/:id",
          "description": "Get team member details",
          "access": "Authenticated",
          "testOrder": 32
        },
        {
          "id": "tea-3",
          "method": "POST",
          "path": "/team",
          "description": "Invite new team member",
          "access": "Authenticated (assign-roles permission)",
          "testOrder": 33,
          "request": {
            "email": "newstaff@business.com",
            "name": "New Staff",
            "role": "sales-assistant",
            "permissions": ["view-products", "record-sales"],
            "department": "Sales"
          }
        },
        {
          "id": "tea-4",
          "method": "PATCH",
          "path": "/team/:id",
          "description": "Update team member",
          "access": "Authenticated (assign-roles permission)",
          "testOrder": 34,
          "request": {
            "name": "Updated Name",
            "phone": "+234-new-phone"
          }
        },
        {
          "id": "tea-5",
          "method": "DELETE",
          "path": "/team/:id",
          "description": "Remove team member",
          "access": "Authenticated (owner only)",
          "testOrder": 35,
          "expectedResponse": {
            "statusCode": 204
          }
        },
        {
          "id": "tea-6",
          "method": "PATCH",
          "path": "/team/:id/permissions",
          "description": "Update member permissions",
          "access": "Authenticated (assign-roles permission)",
          "testOrder": 36,
          "request": {
            "permissions": [
              "view-products",
              "edit-products",
              "record-sales",
              "view-sales-history"
            ]
          }
        }
      ]
    }
  },

  "testingSequence": {
    "title": "Incremental Testing Guide",
    "instruction": "Follow this order to test endpoints. Each phase depends on previous phases.",
    "phases": [
      {
        "phase": 1,
        "name": "Authentication Foundation",
        "endpoints": ["auth-1", "auth-2", "auth-3"],
        "notes": "Setup user account and test token generation. Save tokens for subsequent tests."
      },
      {
        "phase": 2,
        "name": "User Profile",
        "endpoints": ["prof-1", "prof-2"],
        "notes": "Verify profile management works with authenticated user."
      },
      {
        "phase": 3,
        "name": "Inventory Creation",
        "endpoints": ["inv-1", "inv-2", "inv-3"],
        "notes": "Create test products. Save product IDs for sales tests."
      },
      {
        "phase": 4,
        "name": "Inventory Operations",
        "endpoints": ["inv-4", "inv-6"],
        "notes": "Update and decrement inventory to simulate sales."
      },
      {
        "phase": 5,
        "name": "Sales Recording",
        "endpoints": ["sal-3", "sal-1", "sal-2"],
        "notes": "Record and list sales transactions. Verify inventory decrements."
      },
      {
        "phase": 6,
        "name": "Refunds & Holds",
        "endpoints": ["sal-4", "sal-5", "sal-6", "sal-7"],
        "notes": "Test refund processing and transaction holds."
      },
      {
        "phase": 7,
        "name": "Notifications",
        "endpoints": ["not-1", "not-2"],
        "notes": "Verify notification system works."
      },
      {
        "phase": 8,
        "name": "Analytics",
        "endpoints": ["ana-2", "ana-3", "ana-4", "ana-5", "ana-1"],
        "notes": "Test analytics endpoints with recorded sales data."
      },
      {
        "phase": 9,
        "name": "Team Management",
        "endpoints": ["tea-1", "tea-3", "tea-4", "tea-6"],
        "notes": "Manage team members and permissions."
      }
    ]
  },

  "verificationChecklist": [
    "All endpoints return correct HTTP status codes",
    "JWT authentication works on protected routes",
    "Business data isolation enforced (users can't see others' data)",
    "Pagination works correctly with page and limit",
    "Filtering and sorting function as specified",
    "Inventory properly decrements/increments on sales/refunds",
    "Error messages are clear and descriptive",
    "Database transactions are atomic",
    "Timestamps in ISO-8601 format",
    "Soft deletes don't permanently remove data",
    "Audit logs track who did what and when"
  ],

  "databaseEntities": [
    {
      "name": "User",
      "fields": ["id (UUID)", "email (unique)", "password (hashed)", "firstName", "lastName", "businessName", "role", "createdAt", "updatedAt"],
      "relationships": ["1:Many with Sales", "1:Many with InventoryItem", "1:Many with TeamMember"]
    },
    {
      "name": "InventoryItem",
      "fields": ["id (UUID)", "businessId (FK)", "name", "category (array)", "sku", "wholesalePrice", "sellingPrice", "quantity", "status", "createdAt"],
      "relationships": ["1:Many with SaleItem"],
      "indexes": ["businessId", "name", "sku"]
    },
    {
      "name": "Sale",
      "fields": ["id (UUID)", "businessId (FK)", "items (relation)", "total", "paymentMethod", "status", "saleDate", "soldBy (FK)", "createdAt"],
      "relationships": ["1:Many with SaleItem"],
      "indexes": ["businessId", "saleDate", "status"]
    },
    {
      "name": "SaleItem",
      "fields": ["id (UUID)", "saleId (FK)", "productId (FK)", "quantity", "price", "createdAt"],
      "relationships": ["N:1 with Sale", "N:1 with InventoryItem"],
      "cascadeDelete": true
    },
    {
      "name": "Notification",
      "fields": ["id (UUID)", "businessId (FK)", "userId (FK)", "type", "title", "message", "read", "createdAt"],
      "indexes": ["userId", "read"],
      "ttl": "Auto-delete after 30 days"
    },
    {
      "name": "TeamMember",
      "fields": ["id (UUID)", "businessId (FK)", "userId (FK)", "name", "role", "permissions (array)", "joinedDate", "createdAt"],
      "relationships": ["N:1 with User"],
      "indexes": ["businessId"]
    },
    {
      "name": "HeldTransaction",
      "fields": ["id (UUID)", "businessId (FK)", "customerName", "items (array)", "heldBy (FK)", "createdAt", "expiresAt"],
      "ttl": "Auto-delete after 24 hours"
    }
  ],

  "securityRequirements": {
    "passwordHashing": "bcrypt with 10+ salt rounds",
    "passwordMinLength": 8,
    "passwordRequirements": "1 uppercase + 1 number + 1 special character",
    "jwtAccessTokenExpiry": "15 minutes",
    "jwtRefreshTokenExpiry": "7 days",
    "jwtMinSecretLength": 32,
    "corsOrigin": "Configurable from .env",
    "rateLimiting": "Recommended on auth endpoints",
    "businessIsolation": "Required - users can only access their businessId's data",
    "roleBasedAccess": "RBAC guards on protected routes"
  },

  "environment": {
    "required": [
      "DATABASE_URL",
      "JWT_SECRET",
      "JWT_REFRESH_SECRET",
      "PORT",
      "FRONTEND_URL"
    ],
    "optional": [
      "NODE_ENV (default: development)",
      "CORS_ORIGIN",
      "LOG_LEVEL",
      "SMTP_HOST (for email notifications)"
    ]
  },

  "implementationOrder": [
    "1. Setup NestJS project with TypeORM + PostgreSQL",
    "2. Create AuthModule (register, login, refresh, JWT strategy)",
    "3. Create UserModule (profile, settings, password change)",
    "4. Create InventoryModule (CRUD, list, filter, decrement)",
    "5. Create SalesModule (record, list, refund, held transactions)",
    "6. Create AnalyticsModule (summary, charts, top products)",
    "7. Create NotificationModule (list, mark read, delete)",
    "8. Create TeamModule (list members, invite, update permissions)",
    "9. Add global exception filter and response formatting",
    "10. Add Swagger documentation to all endpoints",
    "11. Write integration tests for each module",
    "12. Setup Docker + database seeding for development"
  ]
}
